# Copy to Backend/.env and adjust. Defaults are defined in app/core/config.py.

# --- App ---
APP_NAME=AI Contract Analyzer
APP_VERSION=0.1.0
# development | staging | production
ENVIRONMENT=development
# Set to False in production
DEBUG=True

# --- API ---
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# With Docker Compose the host is "db". Without Docker use "localhost".
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/contract_analyzer
DB_ECHO=False

# --- Redis (not used by the current code) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# REQUIRED: replace with a long random value. Never commit the real one.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File storage ---
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=25
REPORTS_DIR=storage/reports

# --- AI / LLM ---
# Keep Ollama as the local development default.
LLM_PROVIDER=ollama

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# PaddleOCR remains the local default; use Gemini for scanned pages in hosting.
OCR_PROVIDER=local

# Docker Desktop (Windows/macOS). The Linux server value still needs to be decided.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL_NAME=qwen2.5:7b-instruct
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-2

# Hosted deployments should override these in the platform environment:
# LLM_PROVIDER=gemini
# OCR_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
