# Copy to .env in the project root ON THE SERVER and fill in real values.
# Used by docker-compose.prod.yml. Never commit the real .env.

# Required
POSTGRES_PASSWORD=test-only-password
JWT_SECRET_KEY=test-only-jwt-secret-change-before-production
GEMINI_API_KEY=
POSTGRES_APP_PASSWORD=

# Optional (defaults shown)
# POSTGRES_USER=postgres
# POSTGRES_DB=contract_analyzer
POSTGRES_APP_USER=contract_app
GEMINI_MODEL_NAME=gemini-3.1-flash-lite

# Optional, comma-separated browser origins for separate frontend domains.
# Leave empty for the production same-origin Nginx API proxy.
ALLOWED_ORIGINS=

# Managed PostgreSQL only: use a runtime-role URL for the backend and an
# owner/admin URL for the one-shot migration service. URL-encode credentials.
# APP_DATABASE_URL=postgresql+psycopg2://contract_app:...@db-host:5432/dbname?sslmode=require
# MIGRATION_DATABASE_URL=postgresql+psycopg2://migration-owner:...@db-host:5432/dbname?sslmode=require
